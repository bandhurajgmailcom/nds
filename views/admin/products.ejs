<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Products - <%= companyName %></title>
  <link rel="stylesheet" href="/style.css">
  <style>
    .search-bar { display:flex; gap:8px; margin-bottom:16px; }
    .search-bar input { flex:1; padding:7px 10px; font-size:13px; border:1px solid #ccc; border-radius:4px; }
    .search-bar button { padding:7px 14px; font-size:13px; background:#1976d2; color:#fff; border:none; border-radius:4px; cursor:pointer; }
    .search-bar a { padding:7px 12px; font-size:13px; color:#555; border:1px solid #ccc; border-radius:4px; text-decoration:none; background:#f5f5f5; }

    /* Inline edit */
    tr.view-row td { vertical-align:middle; }
    tr.edit-row { display:none; background:#f9fbe7; }
    tr.edit-row td { padding:5px 6px; vertical-align:middle; }
    tr.edit-row input, tr.edit-row select { width:100%; padding:3px 5px; font-size:12px; border:1px solid #bbb; border-radius:3px; box-sizing:border-box; }
    .btn-edit   { padding:3px 9px; font-size:12px; background:#1976d2; color:#fff; border:none; border-radius:3px; cursor:pointer; }
    .btn-save   { padding:3px 9px; font-size:12px; background:#388e3c; color:#fff; border:none; border-radius:3px; cursor:pointer; }
    .btn-cancel { padding:3px 9px; font-size:12px; background:#757575; color:#fff; border:none; border-radius:3px; cursor:pointer; }
    .action-btns { display:flex; gap:4px; flex-wrap:nowrap; }
    .data-table th, .data-table td { font-size:13px; }
    .data-table td:first-child { width:40px; text-align:center; }
    .col-sn   { width:50px; }
    .col-name { min-width:140px; }
    .col-sm   { width:90px; }
    .col-num  { width:80px; }
    .col-act  { width:110px; }
  </style>
</head>
<body>
  <%- include('../partials/navbar') %>
  <main class="main-content">
    <div class="page-header"><h2>📦 Product Management</h2></div>

    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <!-- Add Product -->
    <div class="card">
      <h3>Add New Product</h3>
      <form method="POST" action="/admin/products/add" class="form-grid">
        <div class="form-group">
          <label>SN</label>
          <input type="number" name="sn" placeholder="Auto">
        </div>
        <div class="form-group">
          <label>Product Name <span style="color:red">*</span></label>
          <input type="text" name="product" required placeholder="e.g. Full Cream Milk">
        </div>
        <div class="form-group">
          <label>Category</label>
          <input type="text" name="category" list="cat-list" placeholder="e.g. Milk">
          <datalist id="cat-list">
            <% categories.forEach(c => { %><option value="<%= c %>"><% }) %>
          </datalist>
        </div>
        <div class="form-group">
          <label>Sub-category</label>
          <input type="text" name="subcategory" list="subcat-list" placeholder="e.g. Pasteurized">
          <datalist id="subcat-list">
            <% subcategories.forEach(s => { %><option value="<%= s %>"><% }) %>
          </datalist>
        </div>
        <div class="form-group">
          <label>Unit</label>
          <input type="text" name="unit" list="unit-list" placeholder="e.g. Liter">
          <datalist id="unit-list">
            <% units.forEach(u => { %><option value="<%= u %>"><% }) %>
          </datalist>
        </div>
        <div class="form-group">
          <label>QTY / Pack</label>
          <input type="text" name="qty" list="qty-list" placeholder="e.g. 500ml">
          <datalist id="qty-list">
            <% qtys.forEach(q => { %><option value="<%= q %>"><% }) %>
          </datalist>
        </div>
        <div class="form-group">
          <label>Wholesale (Rs.)</label>
          <input type="number" step="0.01" name="wholesale" placeholder="e.g. 75">
        </div>
        <div class="form-group">
          <label>MRP (Rs.)</label>
          <input type="number" step="0.01" name="mrp" placeholder="e.g. 85">
        </div>
        <div class="form-group form-full">
          <label>Description</label>
          <input type="text" name="description" placeholder="Optional">
        </div>
        <div class="form-full">
          <button type="submit" class="btn-primary">Add Product</button>
        </div>
      </form>
    </div>

    <!-- Product List -->
    <div class="card">
      <h3>All Products <span style="font-size:13px;font-weight:normal;color:#888;">(<%= products.length %> items)</span></h3>

      <form method="GET" action="/admin/products" class="search-bar">
        <input type="text" name="search" value="<%= search %>" placeholder="Search product, category, sub-category...">
        <button type="submit">Search</button>
        <% if (search) { %><a href="/admin/products">Clear</a><% } %>
      </form>

      <div style="overflow-x:auto;">
        <table class="data-table">
          <thead>
            <tr>
              <th class="col-sn">SN</th>
              <th class="col-name">Product</th>
              <th class="col-sm">Category</th>
              <th class="col-sm">Sub-category</th>
              <th class="col-sm">Unit</th>
              <th class="col-sm">QTY</th>
              <th class="col-num">Wholesale</th>
              <th class="col-num">MRP</th>
              <th class="col-act">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% products.forEach((p, i) => {
                 const pid = p.ID || p.id;
                 const sn  = p.SN  || p.sn  || '';
                 const nm  = p.PRODUCT || p.product || '';
                 const cat = p.CATEGORY || p.category || '';
                 const sub = p.SUBCATEGORY || p.subcategory || '';
                 const unt = p.UNIT || p.unit || '';
                 const qty = p.QTY || p.qty || '';
                 const ws  = p.WHOLESALE || p.wholesale;
                 const mrp = p.MRP || p.mrp;
                 const desc= p.DESCRIPTION || p.description || '';
            %>

            <!-- View row -->
            <tr class="view-row" id="view-<%= pid %>">
              <td><%= sn || '-' %></td>
              <td><strong><%= nm %></strong></td>
              <td><%= cat || '-' %></td>
              <td><%= sub || '-' %></td>
              <td><%= unt || '-' %></td>
              <td><%= qty || '-' %></td>
              <td><%= ws  != null ? ws  : '-' %></td>
              <td><%= mrp != null ? mrp : '-' %></td>
              <td>
                <div class="action-btns">
                  <button class="btn-edit" onclick="startEdit(<%= pid %>)">Edit</button>
                  <form method="POST" action="/admin/products/delete/<%= pid %>" onsubmit="return confirm('Delete this product?')">
                    <button class="btn-danger-sm">Del</button>
                  </form>
                </div>
              </td>
            </tr>

            <!-- Edit row -->
            <tr class="edit-row" id="edit-<%= pid %>">
              <td>
                <form id="form-<%= pid %>" method="POST" action="/admin/products/update/<%= pid %>">
                  <input type="number" name="sn" value="<%= sn %>">
              </td>
              <td><input type="text" name="product" value="<%= nm %>" required></td>
              <td>
                <input type="text" name="category" value="<%= cat %>" list="cat-list">
              </td>
              <td>
                <input type="text" name="subcategory" value="<%= sub %>" list="subcat-list">
              </td>
              <td>
                <input type="text" name="unit" value="<%= unt %>" list="unit-list">
              </td>
              <td>
                <input type="text" name="qty" value="<%= qty %>" list="qty-list">
              </td>
              <td>
                <input type="number" step="0.01" name="wholesale" value="<%= ws != null ? ws : '' %>">
              </td>
              <td>
                <input type="number" step="0.01" name="mrp" value="<%= mrp != null ? mrp : '' %>">
                <input type="hidden" name="description" value="<%= desc %>">
                </form>
              </td>
              <td>
                <div class="action-btns">
                  <button class="btn-save"   onclick="document.getElementById('form-<%= pid %>').submit()">Save</button>
                  <button class="btn-cancel" onclick="cancelEdit(<%= pid %>)">Cancel</button>
                </div>
              </td>
            </tr>

            <% }) %>
            <% if (products.length === 0) { %>
            <tr><td colspan="9" class="empty">No products found.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <script>
    function startEdit(id) {
      document.getElementById('view-' + id).style.display = 'none';
      document.getElementById('edit-' + id).style.display = 'table-row';
    }
    function cancelEdit(id) {
      document.getElementById('edit-' + id).style.display = 'none';
      document.getElementById('view-' + id).style.display = '';
    }
  </script>
  <script src="/nepali-calendar.js"></script>
</body>
</html>
