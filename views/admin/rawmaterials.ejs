<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Raw Materials - <%= companyName %></title>
  <link rel="stylesheet" href="/style.css">
  <style>
    .picklist-panels { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px; }
    @media (max-width: 600px) { .picklist-panels { grid-template-columns: 1fr; } }
    .picklist-card { background: #fff; border: 1px solid #e0e0e0; border-radius: 6px; padding: 14px 16px; }
    .picklist-card h4 { margin: 0 0 10px; font-size: 14px; color: #555; text-transform: uppercase; letter-spacing: .5px; }
    .picklist-add { display: flex; gap: 6px; margin-bottom: 10px; }
    .picklist-add input { flex: 1; padding: 5px 8px; font-size: 13px; border: 1px solid #ccc; border-radius: 4px; }
    .picklist-add button { padding: 5px 12px; font-size: 13px; background: #1976d2; color: #fff; border: none; border-radius: 4px; cursor: pointer; white-space: nowrap; }
    .picklist-list { display: flex; flex-wrap: wrap; gap: 6px; }
    .picklist-tag { display: inline-flex; align-items: center; gap: 4px; background: #f5f5f5; border: 1px solid #ddd; border-radius: 14px; padding: 2px 10px 2px 12px; font-size: 13px; }
    .picklist-tag button { background: none; border: none; color: #999; cursor: pointer; font-size: 15px; line-height: 1; padding: 0 2px; }
    .picklist-tag button:hover { color: #e53935; }
    .picklist-empty { color: #bbb; font-size: 13px; font-style: italic; }
  </style>
</head>
<body>
  <%- include('../partials/navbar') %>
  <main class="main-content">
    <div class="page-header">
      <h2>🌿 Raw Materials</h2>
      <div style="display:flex;gap:8px;">
        <a href="/admin/recipes" class="btn-primary" style="text-decoration:none;padding:6px 14px;font-size:14px;">View Recipes</a>
        <a href="/admin/products" style="text-decoration:none;padding:6px 14px;font-size:14px;background:#e8f5e9;color:#388e3c;border-radius:4px;">Products</a>
      </div>
    </div>

    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <!-- Picklist Management -->
    <div class="picklist-panels">
      <div class="picklist-card">
        <h4>Categories</h4>
        <form method="POST" action="/admin/rawmaterials/categories/add" class="picklist-add">
          <input type="text" name="name" placeholder="Add category..." required>
          <button type="submit">+ Add</button>
        </form>
        <div class="picklist-list">
          <% if (categories.length === 0) { %>
            <span class="picklist-empty">No categories yet.</span>
          <% } %>
          <% categories.forEach(c => { %>
            <span class="picklist-tag">
              <%= c.name %>
              <form method="POST" action="/admin/rawmaterials/categories/delete/<%= c.id %>" style="display:inline;" onsubmit="return confirm('Remove category &quot;<%= c.name %>&quot;?')">
                <button type="submit" title="Remove">×</button>
              </form>
            </span>
          <% }) %>
        </div>
      </div>

      <div class="picklist-card">
        <h4>Units</h4>
        <form method="POST" action="/admin/rawmaterials/units/add" class="picklist-add">
          <input type="text" name="name" placeholder="Add unit..." required>
          <button type="submit">+ Add</button>
        </form>
        <div class="picklist-list">
          <% if (units.length === 0) { %>
            <span class="picklist-empty">No units yet.</span>
          <% } %>
          <% units.forEach(u => { %>
            <span class="picklist-tag">
              <%= u.name %>
              <form method="POST" action="/admin/rawmaterials/units/delete/<%= u.id %>" style="display:inline;" onsubmit="return confirm('Remove unit &quot;<%= u.name %>&quot;?')">
                <button type="submit" title="Remove">×</button>
              </form>
            </span>
          <% }) %>
        </div>
      </div>
    </div>

    <!-- Add Raw Material -->
    <div class="card">
      <h3>Add Raw Material</h3>
      <form method="POST" action="/admin/rawmaterials/add" class="form-grid">
        <div class="form-group">
          <label>Name <span style="color:red">*</span></label>
          <input type="text" name="name" required placeholder="e.g. Raw Whole Milk">
        </div>
        <div class="form-group">
          <label>Category</label>
          <select name="category">
            <option value="">-- Select --</option>
            <% categories.forEach(c => { %>
              <option value="<%= c.name %>"><%= c.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label>Unit</label>
          <select name="unit">
            <option value="">-- Select --</option>
            <% units.forEach(u => { %>
              <option value="<%= u.name %>"><%= u.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label>Price (Rs.)</label>
          <input type="number" step="0.01" min="0" name="price" placeholder="e.g. 65.50">
        </div>
        <div class="form-full">
          <button type="submit" class="btn-primary">Add Raw Material</button>
        </div>
      </form>
    </div>

    <!-- Raw Materials Table -->
    <div class="card">
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-bottom:10px;">
        <h3 style="margin:0;">All Raw Materials</h3>
        <input type="text" id="rmSearch" placeholder="Search name, category, unit..." oninput="filterRawMaterials()"
          style="padding:6px 10px;font-size:13px;border:1px solid #ccc;border-radius:4px;min-width:220px;">
      </div>
      <table class="data-table" id="rmTable">
        <thead>
          <tr>
            <th>#</th>
            <th>Name</th>
            <th>Category</th>
            <th>Unit</th>
            <th>Price (Rs.)</th>
            <th>Notes</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% materials.forEach((m, i) => { %>
          <tr class="rm-row"
              data-name="<%= (m.name||'').toLowerCase() %>"
              data-category="<%= (m.category||'').toLowerCase() %>"
              data-unit="<%= (m.unit||'').toLowerCase() %>">
            <td><%= i + 1 %></td>
            <td><strong><%= m.name %></strong></td>
            <td><%= m.category || '-' %></td>
            <td><%= m.unit || '-' %></td>
            <td><%= m.price != null ? 'Rs. ' + m.price : '-' %></td>
            <td><%= m.notes || '-' %></td>
            <td style="display:flex;gap:6px;">
              <button class="btn-primary" style="padding:4px 10px;font-size:13px;"
                data-id="<%= m.id %>"
                data-name="<%= m.name||'' %>"
                data-category="<%= m.category||'' %>"
                data-unit="<%= m.unit||'' %>"
                data-price="<%= m.price != null ? m.price : '' %>"
                onclick="openEdit(this)">Edit</button>
              <form method="POST" action="/admin/rawmaterials/delete/<%= m.id %>" onsubmit="return confirm('Delete this raw material? This will also remove it from all recipes.')">
                <button class="btn-danger-sm">Delete</button>
              </form>
            </td>
          </tr>
          <% }) %>
          <% if (materials.length === 0) { %>
          <tr><td colspan="7" class="empty">No raw materials added yet.</td></tr>
          <% } %>
        </tbody>
      </table>
      <p id="rmNoMatch" style="display:none;padding:14px;color:#9e9e9e;font-style:italic;margin:0;">No raw materials match your search.</p>
    </div>
  </main>

  <!-- Edit Modal -->
  <div id="editModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:1000;align-items:center;justify-content:center;">
    <div style="background:#fff;border-radius:8px;padding:28px 28px 20px;width:100%;max-width:440px;box-shadow:0 4px 24px rgba(0,0,0,.18);">
      <h3 style="margin:0 0 18px;">Edit Raw Material</h3>
      <form id="editForm" method="POST" action="" class="form-grid">
        <div class="form-group form-full">
          <label>Name <span style="color:red">*</span></label>
          <input type="text" id="editName" name="name" required>
        </div>
        <div class="form-group">
          <label>Category</label>
          <select id="editCategory" name="category">
            <option value="">-- Select --</option>
            <% categories.forEach(c => { %>
              <option value="<%= c.name %>"><%= c.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label>Unit</label>
          <select id="editUnit" name="unit">
            <option value="">-- Select --</option>
            <% units.forEach(u => { %>
              <option value="<%= u.name %>"><%= u.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group form-full">
          <label>Price (Rs.)</label>
          <input type="number" step="0.01" min="0" id="editPrice" name="price">
        </div>
        <div class="form-full" style="display:flex;gap:8px;justify-content:flex-end;margin-top:4px;">
          <button type="button" onclick="closeEdit()" style="padding:7px 18px;border:1px solid #ccc;background:#f5f5f5;border-radius:4px;cursor:pointer;">Cancel</button>
          <button type="submit" class="btn-primary">Save Changes</button>
        </div>
      </form>
    </div>
  </div>

  <script src="/nepali-calendar.js"></script>
  <script>
    function openEdit(btn) {
      var id = btn.dataset.id;
      var name = btn.dataset.name;
      var category = btn.dataset.category;
      var unit = btn.dataset.unit;
      var price = btn.dataset.price;
      document.getElementById('editForm').action = '/admin/rawmaterials/edit/' + id;
      document.getElementById('editName').value = name;
      document.getElementById('editPrice').value = price;
      var catSel = document.getElementById('editCategory');
      for (var i = 0; i < catSel.options.length; i++)
        catSel.options[i].selected = catSel.options[i].value === category;
      var unitSel = document.getElementById('editUnit');
      for (var i = 0; i < unitSel.options.length; i++)
        unitSel.options[i].selected = unitSel.options[i].value === unit;
      document.getElementById('editModal').style.display = 'flex';
    }
    function closeEdit() {
      document.getElementById('editModal').style.display = 'none';
    }
    document.getElementById('editModal').addEventListener('click', function(e) {
      if (e.target === this) closeEdit();
    });

    function filterRawMaterials() {
      const q = document.getElementById('rmSearch').value.toLowerCase().trim();
      const rows = document.querySelectorAll('#rmTable .rm-row');
      let anyVisible = false;
      rows.forEach(row => {
        const match = !q ||
          row.dataset.name.includes(q) ||
          row.dataset.category.includes(q) ||
          row.dataset.unit.includes(q);
        row.style.display = match ? '' : 'none';
        if (match) anyVisible = true;
      });
      document.getElementById('rmNoMatch').style.display = (rows.length && !anyVisible) ? '' : 'none';
    }
  </script>
</body>
</html>
